# Runs every executable file in /etc/periodic/<interval>, in name order.
# CRON_DAILY, CRON_WEEKLY, CRON_MONTHLY and CRON_YEARLY set four of the
# schedules; a crontab file in /etc/cron.d adds any other schedule.
#
# min  hour day month weekday command
*      *    *   *     *       /usr/bin/cron --run-parts /etc/periodic/min
*/5    *    *   *     *       /usr/bin/cron --run-parts /etc/periodic/5min
*/10   *    *   *     *       /usr/bin/cron --run-parts /etc/periodic/10min
*/15   *    *   *     *       /usr/bin/cron --run-parts /etc/periodic/15min
*/30   *    *   *     *       /usr/bin/cron --run-parts /etc/periodic/30min
0      *    *   *     *       /usr/bin/cron --run-parts /etc/periodic/hourly
${CRON_DAILY}                 /usr/bin/cron --run-parts /etc/periodic/daily
${CRON_WEEKLY}                /usr/bin/cron --run-parts /etc/periodic/weekly
${CRON_MONTHLY}               /usr/bin/cron --run-parts /etc/periodic/monthly
${CRON_YEARLY}                /usr/bin/cron --run-parts /etc/periodic/yearly
